rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if true;
    }

    match /clients/{docId} {
      allow read, write: if true;
    }

    match /projects/{docId} {
      allow read, write: if true;
    }

    match /incentives/{docId} {
      allow read, write: if true;
    }

    match /services/{docId} {
      allow read, write: if true;
    }

    match /sales_employees/{docId} {
      allow read, write: if true;
    }

    match /master_sales/{docId} {
      allow read, write: if true;
    }

    match /sales_journals/{docId} {
      allow read, write: if true;
    }

    match /{document=**} {
      allow read, write: if true;
    }
  }
}


